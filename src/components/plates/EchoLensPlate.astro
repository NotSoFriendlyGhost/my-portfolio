---
// Pl. 03 — why reading is a lighting problem before it is an OCR problem.
// Left: side view (camera, lamp, mirror angle, distance d). Right: the page
// as the camera gets it, with the lines the glare takes away.

const f = (n: number) => n.toFixed(1);

const L = { x: 82, y: 84 }; // lens
const G = { x: 130, y: 236 }; // where the lamp mirrors into the lens
const lamp = { x: 173, y: 99 };
const PAGE_Y = 236;

const camAngle = (Math.atan2(PAGE_Y - L.y, 141 - L.x) * 180) / Math.PI;

function head(tx: number, ty: number, ux: number, uy: number, size = 6) {
  const nx = -uy;
  const ny = ux;
  const bx = tx - ux * size;
  const by = ty - uy * size;
  return `M${f(tx)} ${f(ty)} L${f(bx + nx * size * 0.42)} ${f(by + ny * size * 0.42)} L${f(bx - nx * size * 0.42)} ${f(by - ny * size * 0.42)} Z`;
}

// reflected ray G -> lens, arrowhead just short of the lens
const rx = L.x - G.x;
const ry = L.y - G.y;
const rl = Math.hypot(rx, ry);
const ux = rx / rl;
const uy = ry / rl;
const rayHead = head(L.x - ux * 8, L.y - uy * 8, ux, uy);

// page hatch (section convention)
const hatch = Array.from({ length: 24 }, (_, i) => 28 + i * 8)
  .map((x) => `M${x} ${PAGE_Y + 2} l-5 6`)
  .join(" ");

// rays off the lamp
const lampRays = Array.from({ length: 8 }, (_, i) => {
  const a = (i * Math.PI) / 4;
  const c = Math.cos(a);
  const s = Math.sin(a);
  return `M${f(lamp.x + c * 9)} ${f(lamp.y + s * 9)} L${f(lamp.x + c * 14)} ${f(lamp.y + s * 14)}`;
}).join(" ");

// page lines (plan view)
const lines = [
  { y: 80, end: 372 },
  { y: 99, end: 364 },
  { y: 118, end: 372 },
  { y: 137, end: 352 },
  { y: 156, end: 372 },
  { y: 175, end: 360 },
  { y: 194, end: 368 },
  { y: 213, end: 340 },
];
const lost = new Set([3, 4]);
const lineBars = lines.map((l) => `M268 ${l.y} H${l.end}`).join(" ");
const okTicks = lines
  .map((l, i) => (lost.has(i) ? "" : `M240 ${l.y} l2.5 2.5 l5 -6`))
  .join(" ");

// speech, minus the glare
const wave = [4, 8, 13, 7, -1, -1, 11, 6, 3].map((h, i) => ({ x: 334 + i * 6.5, h }));
---

<svg
  class="drawing"
  viewBox="0 0 400 280"
  role="img"
  aria-label="Left: a side view of a camera looking down at a page from distance d, with a lamp positioned so its reflection bounces straight into the lens, producing a glare patch. Right: the page as the camera sees it, with two lines of text washed out by that glare and therefore missing from the speech."
>
  <!-- side view -->
  <path d={`M24 ${PAGE_Y} H216`} class="ln-bold"></path>
  <path d={hatch} class="ln-soft"></path>

  <!-- field of view -->
  <path d={`M${L.x} ${L.y} L92 ${PAGE_Y} L190 ${PAGE_Y} Z`} fill="var(--accent)" opacity="0.06"></path>
  <path d={`M${L.x} ${L.y} L92 ${PAGE_Y} M${L.x} ${L.y} L190 ${PAGE_Y}`} class="ln-soft dash"></path>

  <!-- camera -->
  <g transform={`rotate(${f(camAngle)} ${L.x} ${L.y})`}>
    <rect x="50" y="73" width="32" height="22" class="sheet"></rect>
    <circle cx={L.x} cy={L.y} r="5.5" class="sheet"></circle>
  </g>
  <text x="100" y="58" class="t-small">camera</text>

  <!-- distance -->
  <path d={`M40 ${L.y + 6} V${PAGE_Y - 6}`} class="ln"></path>
  <path d={head(40, L.y, 0, -1, 7)} class="fill-ink"></path>
  <path d={head(40, PAGE_Y, 0, 1, 7)} class="fill-ink"></path>
  <path d={`M34 ${L.y} H64`} class="ln-soft dash"></path>
  <text x="33" y="166" text-anchor="end" class="t-serif t-accent">d</text>

  <!-- lamp and mirror angle -->
  <circle cx={lamp.x} cy={lamp.y} r="6" class="sheet"></circle>
  <path d={lampRays} class="ln"></path>
  <text x="188" y="94" class="t-small">lamp</text>
  <path d={`M${lamp.x} ${lamp.y} L${G.x} ${G.y}`} class="ln"></path>
  <path d={`M${G.x} ${G.y} L${f(L.x - ux * 8)} ${f(L.y - uy * 8)}`} fill="none" stroke="var(--accent)" stroke-width="1.4"></path>
  <path d={rayHead} class="fill-accent"></path>
  <path d={`M${G.x} ${G.y} V190`} class="ln-soft dash"></path>
  <path d="M130 196 A40 40 0 0 0 118 197.9" class="ln"></path>
  <path d="M130 196 A40 40 0 0 1 142 197.9" class="ln"></path>
  <text x="112" y="190" text-anchor="middle" class="t-serif" style="font-size:11px">θ</text>
  <text x="148" y="190" text-anchor="middle" class="t-serif" style="font-size:11px">θ</text>

  <!-- the glare itself -->
  <path d={`M114 ${PAGE_Y} H146`} stroke="var(--accent)" stroke-width="3.6" fill="none"></path>
  <text x="130" y="258" text-anchor="middle" class="t-accent">glare</text>

  <!-- plan view: the page as the camera gets it -->
  <text x="256" y="48" class="t-small">as the camera gets it</text>
  <rect x="256" y="56" width="128" height="180" class="sheet"></rect>
  <path d={lineBars} stroke="currentColor" stroke-opacity="0.5" stroke-width="2.4" fill="none"></path>
  <ellipse cx="318" cy="146" rx="42" ry="24" fill="var(--sheet)" opacity="0.9"></ellipse>
  <ellipse cx="318" cy="146" rx="42" ry="24" fill="none" stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="3 2"></ellipse>
  <path d={okTicks} class="ln"></path>
  <text x="244" y="140" text-anchor="middle" class="t-serif t-accent" style="font-size:11px">?</text>
  <text x="244" y="159" text-anchor="middle" class="t-serif t-accent" style="font-size:11px">?</text>

  <!-- speech, minus what was lost -->
  <text x="256" y="266">→ speech</text>
  {wave.map((b) =>
    b.h < 0 ? (
      <circle cx={f(b.x)} cy="262" r="0.9" class="fill-ink"></circle>
    ) : (
      <path d={`M${f(b.x)} ${262 - b.h / 2} V${262 + b.h / 2}`} class="ln-bold"></path>
    ),
  )}

  <g class="reveal">
    <text x="24" y="24" class="t-small t-accent">angle in = angle out:</text>
    <text x="24" y="35" class="t-small t-accent">the glare lands in the lens</text>
    <text x="40" y="276" class="t-small">farther away, smaller letters</text>
  </g>
</svg>
