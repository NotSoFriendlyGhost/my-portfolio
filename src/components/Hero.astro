---
import { site } from "../data/site";
import { withBase } from "../lib/url";

const [first, ...rest] = site.name.split(" ");
const photo = site.heroPhoto;
---

<section class="hero wrap" aria-label="Introduction">
  <div class="copy">
    <h1>{first} <em>{rest.join(" ")}</em></h1>

    <p class="intro">
      I’m an incoming undergraduate at Yale, interested in computer science, engineering, and
      research. I like the point where something has to work outside a theory or a simulation,
      because that is usually when the interesting problems show up.
    </p>
    <p class="more">
      So far that has meant biomedical research, software tools for researchers, an assistive
      reading prototype, and competitive robotics.
    </p>
  </div>

  <figure class="photo">
    <img
      src={withBase(photo.src)}
      alt={photo.alt}
      width={photo.width}
      height={photo.height}
      fetchpriority="high"
    />
  </figure>
</section>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    padding: clamp(2rem, 6vh, 3.5rem) 0 2.5rem;
    align-items: start;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2.7rem, 9vw, 4.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  h1 em {
    font-style: italic;
    font-weight: 400;
  }

  .intro {
    margin: 1.5rem 0 0;
    max-width: 30rem;
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .more {
    margin: 1rem 0 0;
    max-width: 30rem;
    color: var(--ink-soft);
  }

  .photo {
    margin: 0;
    max-width: 26rem;
  }

  .photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 20%;
    filter: grayscale(0.35) contrast(1.03);
    transition: filter 0.35s var(--ease);
  }

  .photo:hover img,
  .photo:focus-within img {
    filter: grayscale(0) contrast(1.02);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      column-gap: 4.5rem;
      padding-top: clamp(3rem, 9vh, 5rem);
    }

    .photo {
      margin-top: 2rem;
      width: min(100%, 22rem);
      justify-self: end;
    }
  }

  @media (hover: none) {
    .photo img {
      filter: grayscale(0.15) contrast(1.02);
    }
  }
</style>
