---
const name = "Caspar Chen";
const username = "NotSoFriendlyGhost";

// Define TypeScript type for GitHub API repos
interface Repo {
  id: number;
  name: string;
  description: string;
  html_url: string;
  language: string;
  stargazers_count: number;
  fork: boolean;
}

let repos: Repo[] = [];

try {
  // Fetch public repositories directly from GitHub's API
  const response = await fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=6`);
  if (response.ok) {
    const data = await response.json();
    // Filter out forks so it only shows original projects you created
    repos = data.filter((repo: Repo) => !repo.fork);
  }
} catch (error) {
  console.error("Error fetching GitHub repos:", error);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name} | Portfolio</title>
  </head>
  <body>

    <!-- Header / Navigation -->
    <header>
      <div class="logo">{name}</div>
      <nav>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href={`https://github.com/${username}`} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <!-- Hero Title Section -->
      <section id="hero" class="hero-section">
        <h1>Hi, I'm <span class="highlight">{name}</span></h1>
        <p class="subtitle">
          Passionate about technology, engineering, and using code to build cool projects.
        </p>
        <div class="cta-buttons">
          <a href="#projects" class="btn primary">View Projects</a>
          <a href={`https://github.com/${username}`} target="_blank" rel="noopener noreferrer" class="btn secondary">GitHub Profile</a>
        </div>
      </section>

      <!-- About Section -->
      <section id="about" class="about-section">
        <h2>About Me</h2>
        <p>
          Welcome to my website! I'm interested in building software, exploring hardware projects, and developing modern web tools.
        </p>
      </section>

      <!-- Dynamic GitHub Projects Section -->
      <section id="projects" class="projects-section">
        <h2>Featured GitHub Repositories</h2>
        <p class="section-desc">Fetched automatically from <code>github.com/{username}</code>:</p>

        <div class="grid">
          {repos.length > 0 ? (
            repos.map((repo) => (
              <article class="card">
                <div class="card-header">
                  <h3>{repo.name}</h3>
                  {repo.language && <span class="badge">{repo.language}</span>}
                </div>
                
                <p>{repo.description || "No description provided for this repository."}</p>

                <div class="card-footer">
                  <a href={repo.html_url} target="_blank" rel="noopener noreferrer">
                    View Repo →
                  </a>
                  {repo.stargazers_count > 0 && <span>⭐ {repo.stargazers_count}</span>}
                </div>
              </article>
            ))
          ) : (
            <p>Loading projects or no public repos found...</p>
          )}
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer>
      <p>&copy; {new Date().getFullYear()} {name}. Built with Astro.</p>
    </footer>

  </body>
</html>

<style>
  /* Global Styles & Reset */
  :root {
    --bg-color: #121212;
    --card-bg: #1a1a1a;
    --text-color: #f0f0f0;
    --text-muted: #aaa;
    --accent-color: #646cff;
    --border-color: #333;
  }

  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    margin: 0;
    padding: 0 1.5rem;
    line-height: 1.6;
  }

  /* Header */
  header {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
  }

  nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--accent-color);
  }

  /* Main & Layout */
  main {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Hero Section */
  .hero-section {
    padding: 4rem 0 3rem;
  }

  h1 {
    font-size: 3rem;
    margin: 0 0 1rem;
  }

  .highlight {
    color: var(--accent-color);
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 600px;
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
  }

  .btn.primary {
    background-color: var(--accent-color);
    color: #fff;
  }

  .btn.secondary {
    border: 1px solid var(--border-color);
    color: #fff;
  }

  /* Sections */
  .about-section, .projects-section {
    padding: 3rem 0;
    border-top: 1px solid #222;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .section-desc {
    color: #888;
    margin-bottom: 2rem;
  }

  code {
    background: #222;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: var(--accent-color);
  }

  /* Cards Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    background-color: var(--card-bg);
    color: var(--text-color);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-color);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .card-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .badge {
    background-color: #2a2a2a;
    color: var(--accent-color);
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-footer a {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
  }

  .card-footer a:hover {
    text-decoration: underline;
  }

  /* Footer */
  footer {
    max-width: 1000px;
    margin: 4rem auto 2rem;
    text-align: center;
    color: #666;
    border-top: 1px solid #222;
    padding-top: 2rem;
  }
</style>