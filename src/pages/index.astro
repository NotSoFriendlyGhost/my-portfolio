---
const name = "Caspar Chen";
const username = "NotSoFriendlyGhost";

// Define TypeScript type for GitHub API repos
interface Repo {
  id: number;
  name: string;
  description: string;
  html_url: string;
  language: string;
  stargazers_count: number;
  fork: boolean;
}

let repos: Repo[] = [];

try {
  // Fetch public repositories directly from GitHub's API
  const response = await fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=6`);
  if (response.ok) {
    const data = await response.json();
    // Filter out forks so it only shows original projects you created
    repos = data.filter((repo: Repo) => !repo.fork);
  }
} catch (error) {
  console.error("Error fetching GitHub repos:", error);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=EB+Garamond:ital@0;1&display=swap" rel="stylesheet" />
    <title>{name} | Portfolio</title>
  </head>
  <body>

    <!-- 360° viewer fills the screen -->
    <div id="viewer" data-github={`https://github.com/${username}`}></div>

    <header>
      <h1>Hi, I'm <span class="highlight">{name}</span></h1>
      <p class="hint">Drag to look around. Tap a pin to zoom in.</p>
    </header>

    <!-- Bottom sheet opened by the pins -->
    <div class="sheet" id="sheet" hidden>
      <button class="close" id="close" aria-label="Close">×</button>

      <section data-panel="about" hidden>
        <h2>About Me</h2>
        <p class="about-text">
          Welcome to my website! I'm interested in building software, exploring hardware projects, and developing modern web tools.
        </p>
      </section>

      <section data-panel="projects" hidden>
        <h2>Featured GitHub Repositories</h2>
        <p class="section-desc">Fetched automatically from <code>github.com/{username}</code>:</p>

        <div class="grid">
          {repos.length > 0 ? (
            repos.map((repo) => (
              <article class="card">
                <div class="card-header">
                  <h3>{repo.name}</h3>
                  {repo.language && <span class="badge">{repo.language}</span>}
                </div>

                <p>{repo.description || "No description provided for this repository."}</p>

                <div class="card-footer">
                  <a href={repo.html_url} target="_blank" rel="noopener noreferrer">
                    View Repo →
                  </a>
                  {repo.stargazers_count > 0 && <span>⭐ {repo.stargazers_count}</span>}
                </div>
              </article>
            ))
          ) : (
            <p>Loading projects or no public repos found...</p>
          )}
        </div>
      </section>
    </div>

  </body>
</html>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';
  import { MarkersPlugin } from '@photo-sphere-viewer/markers-plugin';
  import '@photo-sphere-viewer/core/index.css';
  import '@photo-sphere-viewer/markers-plugin/index.css';

  // Where each pin sits (degrees). yaw: 0-360 around the room, pitch: up (+) / down (-).
  // Click anywhere in the viewer and the console prints the yaw/pitch to use here.
  const hotspots = [
    { id: 'about', label: 'About', yaw: 30, pitch: -5, type: 'panel' },
    { id: 'projects', label: 'Projects', yaw: 120, pitch: -15, type: 'panel' },
    { id: 'github', label: 'GitHub', yaw: 220, pitch: 5, type: 'link' },
  ];

  const container = document.getElementById('viewer') as HTMLElement;
  const sheet = document.getElementById('sheet') as HTMLElement;
  const githubUrl = container.dataset.github as string;

  const viewer = new Viewer({
    container,
    panorama: '/dorm.png', // put your 360 photo at public/dorm.jpg
    defaultZoomLvl: 0,
    navbar: ['zoom', 'fullscreen'],
    plugins: [
      [
        MarkersPlugin,
        {
          markers: hotspots.map((h) => ({
            id: h.id,
            position: { yaw: `${h.yaw}deg`, pitch: `${h.pitch}deg` },
            html: `<span class="pin"></span><span class="pin-label">${h.label}</span>`,
            size: { width: 48, height: 48 },
            anchor: 'center center',
          })),
        },
      ],
    ],
  });

  const markers = viewer.getPlugin(MarkersPlugin) as MarkersPlugin;

  function openSheet(id: string) {
    sheet.querySelectorAll<HTMLElement>('[data-panel]').forEach((s) => {
      s.hidden = s.dataset.panel !== id;
    });
    sheet.hidden = false;
    sheet.scrollTop = 0;
  }

  function closeSheet() {
    sheet.hidden = true;
  }

  markers.addEventListener('select-marker', async ({ marker }) => {
    const h = hotspots.find((x) => x.id === marker.id);
    if (!h) return;

    if (h.type === 'link') {
      window.open(githubUrl, '_blank', 'noopener');
      return;
    }

    closeSheet();
    try {
      // Aim a little below the pin so it sits above the bottom sheet
      await viewer.animate({
        yaw: `${h.yaw}deg`,
        pitch: `${h.pitch - 12}deg`,
        zoom: 55,
        speed: '30rpm',
      });
      openSheet(h.id);
    } catch {
      // Animation was interrupted by the user dragging; do nothing
    }
  });

  // Helper for placing pins: click the view and read yaw/pitch in the console
  viewer.addEventListener('click', ({ data }) => {
    const deg = (r: number) => Math.round((r * 180) / Math.PI);
    console.log(`yaw: ${(deg(data.yaw) + 360) % 360}, pitch: ${deg(data.pitch)}`);
  });

  document.getElementById('close')!.addEventListener('click', closeSheet);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSheet();
  });
</script>

<style is:global>
  :root {
    --bg: #0f1b2d;
    --card-bg: #15253b;
    --text: #e4e9f1;
    --text-muted: #9ba9be;
    --accent: #d1ad62;
    --border: #263a54;
    --font-display: 'Cormorant Garamond', Georgia, serif;
    --font: 'EB Garamond', Georgia, serif;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  #viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
  }

  /* Title over the viewer */
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    padding: calc(env(safe-area-inset-top) + 1rem) 1.25rem 2.5rem;
    background: linear-gradient(to bottom, rgba(15, 27, 45, 0.85), transparent);
    pointer-events: none;
  }

  h1 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    font-style: italic;
    color: var(--accent);
    margin: 0;
  }

  .highlight {
    display: block;
    color: var(--text);
    font-size: clamp(2rem, 6vw, 3rem);
    font-style: normal;
    font-weight: 600;
    line-height: 1.05;
  }

  .hint {
    font-style: italic;
    color: var(--text-muted);
    font-size: 1rem;
    margin: 0.4rem 0 0;
  }

  /* Pins (44px+ touch targets, always visible) */
  .pin {
    display: block;
    width: 48px;
    height: 48px;
    box-sizing: border-box;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: rgba(15, 27, 45, 0.55);
    box-shadow: 0 0 0 4px rgba(209, 173, 98, 0.25);
  }

  .pin::after {
    content: '';
    position: absolute;
    top: 18px;
    left: 18px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }

  .pin-label {
    position: absolute;
    top: 54px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    white-space: nowrap;
    color: var(--accent);
    text-shadow: 0 0 6px var(--bg), 0 0 6px var(--bg), 0 0 10px var(--bg);
  }

  /* Bottom sheet */
  .sheet {
    position: fixed;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    z-index: 20;
    width: min(680px, 100%);
    max-height: 60dvh;
    overflow-y: auto;
    box-sizing: border-box;
    padding: 1.5rem 1.5rem calc(env(safe-area-inset-bottom) + 1.5rem);
    background: var(--bg);
    border: 1px solid var(--accent);
    border-bottom: none;
    animation: rise 0.25s ease-out;
  }

  .sheet[hidden],
  .sheet [hidden] {
    display: none;
  }

  @keyframes rise {
    from {
      transform: translate(-50%, 30px);
      opacity: 0;
    }
    to {
      transform: translate(-50%, 0);
      opacity: 1;
    }
  }

  .close {
    position: absolute;
    top: 0.25rem;
    right: 0.5rem;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .close:hover {
    color: var(--accent);
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  .about-text {
    margin: 0;
  }

  .section-desc {
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }

  code {
    font-family: var(--font);
    font-style: italic;
    color: var(--accent);
  }

  /* Cards */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .card {
    border: 1px solid var(--border);
    background-color: var(--card-bg);
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .card-header h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .badge {
    flex-shrink: 0;
    font-size: 0.95rem;
    font-style: italic;
    color: var(--accent);
  }

  .card p {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 0 1rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-footer a {
    color: var(--accent);
    text-decoration: none;
  }

  .card-footer a:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      animation: none;
    }
  }
</style>