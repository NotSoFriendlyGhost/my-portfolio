---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Plate from "../../components/Plate.astro";
import ScareMouseSystem from "../../components/plates/ScareMouseSystem.astro";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const hasLinks = Boolean(project.repoUrl) || Boolean(project.links?.length);
---

<BaseLayout title={`${project.title} · Caspar Chen`} description={project.summary}>
  <article class="case">
    <div class="wrap top">
      <p class="back"><a href="/#work">Back to selected work</a></p>
      <h1>{project.title}</h1>
      <p class="cat">{project.category}</p>
    </div>

    <div class="wrap layout">
      <div class="prose">
        <p class="summary">{project.intro}</p>

        {project.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.figure === "scaremouse-system" && <ScareMouseSystem />}
          </section>
        ))}

        {hasLinks && (
          <section class="links">
            <h2>Links</h2>
            <ul>
              {project.repoUrl && (
                <li>
                  <a href={project.repoUrl} target="_blank" rel="noopener noreferrer">
                    {project.repoLabel ?? "Repository"}
                  </a>
                </li>
              )}
              {project.links?.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <div class="side">
        <Plate kind={project.diagram} caption={project.plateCaption} note />

        {project.photo && (
          <figure class="photo">
            <img
              src={project.photo.src}
              alt={project.photo.alt}
              width={project.photo.width}
              height={project.photo.height}
              loading="lazy"
            />
            <figcaption>{project.photo.caption}</figcaption>
          </figure>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case {
    padding-bottom: 3rem;
  }

  .top {
    padding: 2.25rem 0 1.5rem;
  }

  .back {
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
  }

  .back a {
    color: var(--muted);
  }

  .back a:hover {
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 20ch;
  }

  .cat {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }

  .layout {
    display: grid;
    gap: 2.5rem;
  }

  .summary {
    margin: 0 0 2rem;
    max-width: 34rem;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--ink);
  }

  section {
    margin-bottom: 1.75rem;
    max-width: var(--measure);
  }

  h2 {
    margin: 0 0 0.4rem;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  section p {
    margin: 0 0 0.8rem;
    color: var(--ink-soft);
  }

  .links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .links a {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .links a:hover {
    color: var(--accent);
  }

  .side {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  .photo {
    margin: 0;
    max-width: 24rem;
  }

  .photo img {
    width: 100%;
    height: auto;
    filter: grayscale(0.2) contrast(1.03);
  }

  .photo figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      column-gap: 4rem;
    }

    .side {
      position: sticky;
      top: 5rem;
      align-self: start;
    }
  }
</style>
